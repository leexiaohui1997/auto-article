{
  "name": "auto-article",
  "version": "0.0.1",
  "description": "基于浏览器自动化与AI的多平台文章自动创作、发布脚本",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "auto-article": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:g": "prisma generate",
    "db:m": "prisma migrate dev",
    "db:d": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.19",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "15",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
